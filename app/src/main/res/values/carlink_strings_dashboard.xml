    <!-- A wireless attempt the phone has not answered for 10 s (connection detail "phone_not_answering"). -->
    <string name="carlink_home_eyebrow_not_answering">No answer</string>
    <string name="carlink_home_not_answering_title">Your phone isn’t answering</string>
    <string name="carlink_home_not_answering_title_iphone">iPhone not reachable over Bluetooth</string>
    <string name="carlink_home_not_answering_body_iphone">Unlock %1$s and check that its Bluetooth is on, or plug it in with a cable.</string>
    <string name="carlink_home_not_answering_body_usb">Unlock %1$s and accept the prompt on its screen. If nothing happens, unplug it and plug it in again.</string>
    <string name="carlink_home_not_answering_body_android">Make sure %1$s has Bluetooth on and is unlocked, then keep it near this screen. Android Auto starts by itself once it connects.</string>
    <!-- Connection v2: pre-flight problems and precise failures. -->
    <string name="carlink_home_error_bt_off_title">Bluetooth is off</string>
    <string name="carlink_home_error_bt_off_body">Wireless connections start over Bluetooth. Turn it on, or plug your phone in with a cable.</string>
    <string name="carlink_home_error_not_paired_title">This phone isn’t paired</string>
    <string name="carlink_home_error_not_paired_body">On your phone, open Bluetooth and pair with this screen, then try again.</string>
    <string name="carlink_home_error_wifi_off_title">Wi-Fi is off</string>
    <string name="carlink_home_error_wifi_off_body">The picture travels over Wi-Fi. Turn Wi-Fi on here; it doesn’t need to be connected to a network.</string>
    <string name="carlink_home_error_location_off_title">Location is off</string>
    <string name="carlink_home_error_location_off_body">Android needs Location switched on to set up the wireless link.</string>
    <string name="carlink_home_error_permissions_title">Permissions needed</string>
    <string name="carlink_home_error_permissions_body">CarLink needs Nearby devices, Location and Microphone to connect your phone.</string>
    <string name="carlink_home_error_overlay_title">Allow CarLink to open over other apps</string>
    <string name="carlink_home_error_overlay_body">So CarPlay or Android Auto can appear as soon as your phone connects.</string>
    <string name="carlink_home_error_vpn_title">Allow the CarPlay connection</string>
    <string name="carlink_home_error_vpn_body">Wired CarPlay runs over a private link. Android asks once to allow it.</string>
    <string name="carlink_home_error_refused_title">Your phone couldn’t join the Wi-Fi</string>
    <string name="carlink_home_error_refused_body">Check the Wi-Fi password in Settings, or switch the connection type to Wi-Fi Direct.</string>
    <string name="carlink_home_error_unreached_title">Your iPhone couldn’t reach this screen</string>
    <string name="carlink_home_error_unreached_body">Your network blocks the link CarPlay needs. Choose Wi-Fi Direct, or plug in with a cable.</string>
    <string name="carlink_home_error_weak_title">The wireless link was too weak</string>
    <string name="carlink_home_error_weak_body">Keep your phone close to the screen and try again, or plug in with a cable.</string>
    <string name="carlink_home_error_no_answer_title">Your phone didn’t answer</string>
    <string name="carlink_home_error_no_answer_body">Unlock your phone, make sure its Bluetooth is on and connected to this screen, then try again.</string>
    <string name="carlink_home_error_bluetooth_title">Bluetooth connection failed</string>
    <string name="carlink_home_error_bluetooth_body">On your phone, turn Bluetooth off and on, then try again. If it keeps failing, forget this screen and pair again.</string>
    <!-- The stereo's Bluetooth is an external module apps cannot use (detect/ExternalBluetoothProbe). -->
    <string name="carlink_home_error_external_bt_title">Wireless isn\'t available on this stereo yet</string>
    <string name="carlink_home_error_external_module_title">Couldn\'t reach the stereo\'s Bluetooth module</string>
    <string name="carlink_home_error_external_module_body">Wireless through the stereo\'s Bluetooth module is experimental, and it didn\'t work here. On an FYT stereo, disable the stereo\'s own “Car Link” app first. Otherwise connect your phone with a USB cable\u00A0— it works the same. Share the log from Diagnostics so this can be fixed.</string>
    <string name="carlink_home_error_external_bt_body">This stereo\'s Bluetooth is a separate module that apps can\'t use, so CarPlay and Android Auto can\'t start wirelessly. Connect your phone with a USB cable\u00A0— it works the same.</string>
    <string name="carlink_home_how_to_connect">How to connect</string>
    <string name="carlink_home_cable_title">Connect with a USB cable</string>
    <string name="carlink_home_cable_body">1. Plug your phone into the stereo\'s USB port with a cable that carries data (not a charge-only cable).\n2. iPhone: CarPlay starts by itself. Android phone: unlock it and allow Android Auto if it asks.\n\nWireless needs the stereo\'s Bluetooth, which apps can\'t reach on this stereo yet.</string>
    <string name="carlink_home_cable_ok">Got it</string>
    <string name="carlink_home_error_usb_title">USB connection failed</string>
    <string name="carlink_home_error_usb_body">Unlock your phone and accept its prompt. Try another cable if it keeps failing.</string>
