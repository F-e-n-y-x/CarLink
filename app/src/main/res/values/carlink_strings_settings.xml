    <string name="carlink_settings_group_wireless">Wireless</string>
    <string name="carlink_settings_root">Root mode</string>
    <string name="carlink_settings_root_detail">For rooted stereos. Allows everything setup asks for without popups, and keeps Wi-Fi in low-latency mode while a phone is connected. Your root manager asks once.</string>
    <string name="carlink_settings_root_unavailable">Root is not available or was refused, so Root mode stays off.</string>
    <string name="carlink_settings_external_bt">Wireless through the stereo\'s Bluetooth module (experimental)</string>
    <string name="carlink_settings_external_bt_detail">This stereo\'s Bluetooth is a separate module. Turn on to let wireless Android Auto reach your phone through it. Not yet tested on a real stereo; USB still works. Applies from the next connection.</string>
    <string name="carlink_settings_external_bt_fyt_note">First disable the stereo\'s own “Car Link” app (com.syu.carlink) in Android Settings › Apps.</string>
    <string name="carlink_settings_method">Connection method</string>
    <string name="carlink_settings_method_detail">How the phone and the car share Wi-Fi</string>
    <string name="carlink_settings_method_auto">Automatic</string>
    <string name="carlink_settings_method_same_wifi">Same Wi-Fi</string>
    <string name="carlink_settings_method_hotspot">Car hotspot</string>
    <string name="carlink_settings_method_direct">Wi-Fi Direct</string>
    <string name="carlink_settings_method_auto_detail">Picks the best path before each connection: same Wi-Fi, then the car hotspot, then Wi-Fi Direct.</string>
    <string name="carlink_settings_method_same_wifi_detail">Phone and car on one router, the fastest path. Needs the Wi-Fi password once.</string>
    <string name="carlink_settings_method_hotspot_detail">The phone joins the Wi-Fi hotspot the car creates. Works with every phone.</string>
    <string name="carlink_settings_method_direct_detail">A direct link between phone and car. No network needed.</string>
    <string name="carlink_settings_method_sheet_body">Bluetooth always starts the connection; the picture and sound then travel over Wi-Fi.</string>

    <string name="carlink_settings_hotspot">Car hotspot</string>
    <string name="carlink_settings_hotspot_detail">Name and password of the car’s own hotspot</string>
    <string name="carlink_settings_hotspot_sheet_body">CarLink reads them from the car where it can and passes them to your phone. Change them here and CarLink changes the car’s hotspot too, where Android allows it.</string>
    <string name="carlink_settings_hotspot_read">Read from the car</string>
    <string name="carlink_settings_hotspot_reading">Reading the car’s hotspot…</string>
    <string name="carlink_settings_hotspot_unreadable">This stereo does not let CarLink read its hotspot. Enter the name and password exactly as the car’s hotspot settings show them.</string>
    <string name="carlink_settings_hotspot_applied">The car’s hotspot now uses this name and password</string>
    <string name="carlink_settings_hotspot_not_applied">Saved in CarLink. This stereo does not let CarLink change its hotspot: set the same name and password in the car’s hotspot settings.</string>
    <string name="carlink_settings_same_wifi">Same Wi-Fi network</string>
    <string name="carlink_settings_same_wifi_detail">The router both the car and your iPhone join</string>
    <string name="carlink_settings_same_wifi_sheet_body">The car must already be on this Wi-Fi. CarLink tells your iPhone to join it over Bluetooth.</string>
