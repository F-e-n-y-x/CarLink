<?xml version="1.0" encoding="utf-8"?>
<!-- CarLink override of DiAuto's exit-menu row (AapProjectionActivity.showExitDialog): same ids,
     Inter and car-sized rows. Sizes live here, not in code, because the ListView measures freshly
     inflated rows. Re-check the ids after a DiAuto subtree pull. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="20dp"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/carlink_inter_medium"
        android:textSize="22sp"
        android:textColor="?android:attr/textColorPrimary" />

</LinearLayout>
