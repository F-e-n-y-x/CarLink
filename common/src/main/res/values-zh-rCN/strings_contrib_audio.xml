<resources>
    <string name="contrib_audio_home_channel_preview_unavailable">此设备无法试听 Android 音频流 %1$d。</string>
    <string name="contrib_audio_home_choice_summary">%1$s · %2$s</string>
    <string name="contrib_audio_home_media_channel_label">媒体音频流</string>
    <string name="contrib_audio_home_nav_channel_label">导航音频流</string>
    <string name="contrib_audio_home_nav_channel_note">0 表示自动路由。1–20 用于选择传统音频流编号，包括车机支持的厂商扩展输出。点选数值可试听。更改在重新连接后生效。</string>
    <string name="contrib_audio_home_toggle_audio_focus">音频焦点</string>
    <string name="contrib_audio_home_toggle_audio_focus_desc">CarPlay 媒体向系统申请音频焦点；导航播报不会压低音乐。若开启后没有声音（部分车机焦点处理异常），请关闭本开关。更改在重新连接后生效。</string>
    <string name="audio_focus_auto_yield">来电自动避让音频焦点</string>
    <string name="audio_focus_auto_yield_desc">来电或通话时自动静音媒体并让出系统音频焦点，挂断后自动恢复。解决车载蓝牙电话与 CarPlay 冲突断联问题。</string>
</resources>
